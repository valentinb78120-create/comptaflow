# ============================================================================
# ComptaFlow — configuration de développement (OPTIONNELLE)
#
# Ce fichier n'est PAS nécessaire pour lancer le projet : `docker compose up`
# fonctionne directement sans lui, avec des valeurs par défaut sûres pour
# le développement (OCR en mode Tesseract local, paiement désactivé).
#
# Copiez ce fichier en ".env" à la racine du projet uniquement si vous
# voulez tester l'OCR Mistral (plus précis) ou Stripe (paiement) :
#
#   cp .env.example .env
#
# Docker Compose lit automatiquement le fichier ".env" du dossier courant.
# ============================================================================

# --- OCR Mistral (facultatif) ---
# Sans clé : l'OCR utilise Tesseract (moteur local gratuit, un peu moins
# précis). Avec une clé : extraction plus fiable via l'IA de Mistral.
# Clé gratuite sur https://console.mistral.ai
MISTRAL_API_KEY=

# --- Paiement Stripe (facultatif) ---
# Sans clés : la facturation est simplement désactivée (aucune erreur),
# l'essai gratuit de 14 jours reste utilisable normalement.
# Clés de test sur https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_DECOUVERTE=
STRIPE_PRICE_ID_CABINET=
STRIPE_PRICE_ID_CABINET_PLUS=

# --- Sécurité (facultatif en dev) ---
# Clé secrète utilisée pour signer les sessions (JWT). Une valeur par
# défaut est fournie pour le développement — changez-la uniquement si
# vous déployez réellement (voir docker-compose.prod.yml).
# Générer une clé forte : python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=dev-secret-not-for-production-use
