# Copy this file to .env and fill in your values

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://compta:compta@localhost:5432/comptaflow
DATABASE_URL_SYNC=postgresql://compta:compta@localhost:5432/comptaflow

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Mistral OCR — get your key at https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Stripe — get keys at https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...

# App
APP_SECRET_KEY=change-me-in-production-use-secrets-token-hex-32
DEBUG=false
UPLOAD_DIR=/tmp/comptaflow/uploads
MAX_UPLOAD_SIZE_MB=20
# true en prod : bloque l'upload si trial expiré sans abonnement
ENFORCE_SUBSCRIPTION=false
