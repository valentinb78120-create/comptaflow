# ============================================================================
# ComptaFlow — variables de PRODUCTION
# Copier en .env.prod sur le serveur et remplir. NE JAMAIS COMMITER .env.prod.
# ============================================================================

# --- Base de données (choisis un mot de passe fort) ---
POSTGRES_USER=comptaflow
POSTGRES_PASSWORD=CHANGE-MOI-mot-de-passe-fort
POSTGRES_DB=comptaflow

# --- Secret de l'app (génère avec : python -c "import secrets;print(secrets.token_hex(32))") ---
APP_SECRET_KEY=CHANGE-MOI-64-caracteres-hex

# --- Mistral OCR (https://console.mistral.ai) — vide = fallback Tesseract ---
MISTRAL_API_KEY=

# --- Stripe (https://dashboard.stripe.com) — vide = facturation désactivée ---
# Créer 3 produits récurrents : Découverte 29€, Cabinet 79€, Cabinet+ 199€
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_DECOUVERTE=
STRIPE_PRICE_ID_CABINET=
STRIPE_PRICE_ID_CABINET_PLUS=

# --- Accès ---
# true en prod : trial expiré sans abonnement → upload bloqué (402)
ENFORCE_SUBSCRIPTION=true
# Domaine(s) du frontend, séparés par des virgules
CORS_ORIGINS=https://app.comptaflow.fr

# --- Port HTTP exposé par nginx (80 derrière un reverse-proxy/Caddy, sinon 80/443) ---
HTTP_PORT=80
